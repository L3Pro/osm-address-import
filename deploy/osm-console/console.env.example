# Copy to /etc/osm-console/console.env; replace placeholders and restrict file permissions.
OSM_CONSOLE_ENV=production
OSM_CONSOLE_REPORT_ROOT=/var/lib/osm-console/reports
OSM_CONSOLE_ROLE_FILE=/etc/osm-console/roles.json
OSM_CONSOLE_ISSUER=https://replace-team.cloudflareaccess.com
OSM_CONSOLE_AUDIENCE=REPLACE_WITH_CONSOLE_APPLICATION_AUD_TAG
